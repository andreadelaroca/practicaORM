<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicaorm.controller.EstudianteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sistema de Gestión Académica - UAM" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints maxWidth="120.0" minWidth="80.0" prefWidth="90.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
            <ColumnConstraints maxWidth="120.0" minWidth="80.0" prefWidth="90.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
        </rowConstraints>

        <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombres" promptText="Nombres del estudiante" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtApellidos" promptText="Apellidos del estudiante" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCorreo" promptText="usuario@dominio.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Carrera:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbCarrera" maxWidth="Infinity" promptText="Seleccione carrera" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtTelefono" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
            <Button fx:id="btnGuardar" defaultButton="true" onAction="#guardarEstudiante" prefWidth="110.0" text="Guardar" />
            <Button fx:id="btnConsultar" onAction="#consultarEstudiantes" prefWidth="110.0" text="Consultar" />
            <Button fx:id="btnFiltrar" onAction="#filtrarPorCarrera" prefWidth="110.0" text="Filtrar" />
        </HBox>
    </GridPane>

    <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNombres" prefWidth="150.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="150.0" text="Apellidos" />
            <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo" />
            <TableColumn fx:id="colCarrera" prefWidth="160.0" text="Carrera" />
            <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>